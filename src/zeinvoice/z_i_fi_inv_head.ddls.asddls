@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'FI Invoice Header'
@Metadata.ignorePropagatedAnnotations: true
define view entity Z_I_FI_INV_HEAD
  as select from I_JournalEntry            as Head
    inner join   I_OperationalAcctgDocItem as Item on  Head.CompanyCode          = Item.CompanyCode
                                                   and Head.AccountingDocument   = Item.AccountingDocument
                                                   and Head.FiscalYear           = Item.FiscalYear
                                                   and Item.FinancialAccountType = 'D' // Customer Line
{
  key Head.CompanyCode,
  key Head.FiscalYear,
  key Head.AccountingDocument,
      Head.AccountingDocumentType,
      // Derived Document Type for E-Invoicing
      case Head.AccountingDocumentType
        when 'DG' then 'CRN' // Credit Memo
        when 'DZ' then 'DBN' // Debit Memo
        else ''
      end                                 as EInvoiceDocType,
      Head.DocumentDate,
      Head.PostingDate,
      Head.AccountingDocumentCreationDate as CreationDate,
      Head.CreationTime,
      Head.DocumentReferenceID,
      Head.TransactionCurrency,
      Item.BusinessPlace,
      Item.Plant,
      // Customer Details
      Item.Customer,
      @Semantics.amount.currencyCode: 'TransactionCurrency'
      // Amount (FI stores credit as negative, taking absolute for display)
      case
        when Item.AmountInTransactionCurrency < 0 then Item.AmountInTransactionCurrency * -1
        else Item.AmountInTransactionCurrency
      end                                 as TotalAmount
}
where
  // Exclude documents generated by SD Billing (Reference VBRK) to avoid duplicates in the cockpit
       Head.ReferenceDocumentType  <> 'VBRK'
  // Filter for Invoice-relevant Document Types
  and(
       Head.AccountingDocumentType =  'DR'
    or Head.AccountingDocumentType =  'DG'
  )
  and  Head.ReverseDocument        is initial
